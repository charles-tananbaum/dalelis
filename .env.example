# Stripe — obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=          # sk_live_... (or sk_test_... for local dev)
STRIPE_WEBHOOK_SECRET=      # whsec_... from Stripe webhook config (Developers → Webhooks)
STRIPE_PORTAL_URL=          # https://billing.stripe.com/p/login/... — self-serve cancel portal. Enable: Settings → Billing → Customer Portal.

# HousecallPro — obtain from https://pro.housecallpro.com/pro/developer_portal
HCP_API_KEY=                # Bearer token from HousecallPro developer settings

# Resend — obtain from https://resend.com/api-keys
RESEND_API_KEY=             # re_... from resend.com
FROM_EMAIL=                 # e.g. Dalelis Mechanical <noreply@dalelismechanical.com>; or sandbox: Dalelis Test <onboarding@resend.dev>

# Twilio — obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID=         # AC... from twilio.com console
TWILIO_AUTH_TOKEN=          # from twilio.com console
TWILIO_FROM_NUMBER=         # Your Twilio number e.g. +18005551234

# Business owner contact (alert recipient)
OWNER_PHONE=                # James's cell e.g. +16175550000
OWNER_EMAIL=                # dalelismechanical@gmail.com

# Optional: blind-CC every signup/cancellation alert to a monitoring address
# (e.g. FieldPass for observability). Leave unset to disable BCC.
MONITOR_EMAIL=              # e.g. charles@fieldpass.pro

# Used to construct Stripe success/cancel redirect URLs
PUBLIC_SITE_URL=            # https://www.dalelismechanical.com

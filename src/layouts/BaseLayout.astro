---
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import MobileCTABar from "~/components/MobileCTABar.astro";
import { SITE, ALL_SERVICE_AREAS } from "~/lib/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schema?: object | object[];
}

const {
  title,
  description,
  image = "/og-default.jpg",
  noindex = false,
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const ogImage = new URL(image, SITE.url).toString();

// Default LocalBusiness schema (always included)
const businessSchema = {
  "@context": "https://schema.org",
  "@type": ["HVACBusiness", "Plumber", "LocalBusiness"],
  "@id": `${SITE.url}/#business`,
  name: SITE.legalName,
  alternateName: SITE.name,
  url: SITE.url,
  telephone: SITE.phoneRaw,
  email: SITE.email,
  description:
    "Licensed plumbing, heating, and air conditioning service in Norwood, MA and 40+ surrounding communities. 24/7 emergency service.",
  foundingDate: `${SITE.foundedYear}-01-01`,
  priceRange: "$$",
  image: ogImage,
  address: {
    "@type": "PostalAddress",
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.state,
    postalCode: SITE.address.zip,
    addressCountry: SITE.address.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: SITE.address.lat,
    longitude: SITE.address.lng,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      opens: "00:00",
      closes: "23:59",
    },
  ],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: SITE.rating.score,
    bestRating: SITE.rating.outOf,
    ratingCount: SITE.rating.count,
  },
  areaServed: ALL_SERVICE_AREAS.map((city) => ({
    "@type": "City",
    name: city,
    containedInPlace: { "@type": "State", name: "Massachusetts" },
  })),
  sameAs: [SITE.facebook, SITE.googleReviews],
  hasCredential: [
    { "@type": "EducationalOccupationalCredential", name: `MA Master Plumbing License #${SITE.licenses.masterPlumbing}` },
    { "@type": "EducationalOccupationalCredential", name: `MA HVAC License #${SITE.licenses.hvac}` },
  ],
};

const schemas = [businessSchema, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#FAF7F1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Preconnect to fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Inter+Tight:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {/* Favicon — Dalelis J.A.D. brand mark */}
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
    <link rel="apple-touch-icon" href="/images/logo.jpg" />

    {/* Theme: prevent flash of wrong theme on load */}
    <script is:inline>
      (function() {
        var t = localStorage.getItem('dalelis-theme');
        if (t === 'card') {
          document.documentElement.setAttribute('data-theme', 'card');
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#1F2A3F');
        }
      })();
    </script>

    {/* JSON-LD */}
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCTABar />

    {/* Theme toggle — event delegation for all [data-theme-toggle] buttons */}
    <script>
      function syncToggleUI(theme) {
        document.querySelectorAll("[data-theme-pill]").forEach(function(pill) {
          pill.style.transform = theme === "card" ? "translateX(36px)" : "translateX(0px)";
        });
        document.querySelectorAll('[data-theme-icon="classic"]').forEach(function(icon) {
          icon.style.color = theme === "card" ? "var(--color-slate)" : "var(--color-ink)";
        });
        document.querySelectorAll('[data-theme-icon="card"]').forEach(function(icon) {
          icon.style.color = theme === "card" ? "var(--color-ink)" : "var(--color-slate)";
        });
      }

      // Set initial UI state
      syncToggleUI(document.documentElement.getAttribute("data-theme") || "classic");

      // Delegate clicks on any toggle button
      document.addEventListener("click", function(e) {
        var btn = e.target.closest("[data-theme-toggle]");
        if (!btn) return;

        var current = document.documentElement.getAttribute("data-theme") || "classic";
        var next = current === "card" ? "classic" : "card";

        document.documentElement.setAttribute("data-theme", next);
        localStorage.setItem("dalelis-theme", next);

        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", next === "card" ? "#0F1419" : "#FAF7F1");

        syncToggleUI(next);
      });
    </script>

    {/* Reveal-on-scroll observer */}
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.08 }
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>

---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Icon from "~/components/Icon.astro";
import { getPlanBySlug } from "~/lib/plans";

// Read URL params at request time (not build time)
export const prerender = false;

// In any environment with a real Stripe key, redirect away from the mock.
// This makes the mock unreachable in production while keeping it accessible
// locally when STRIPE_SECRET_KEY is absent from .env.local.
if (import.meta.env.STRIPE_SECRET_KEY) {
  return Astro.redirect("/maintenance-plans/");
}

// Mock Stripe checkout — representative view only.
// In production this entire page is replaced by Stripe's hosted checkout.
const url = Astro.url;
const planSlug = url.searchParams.get("plan") || "";
const billing = url.searchParams.get("billing") || "annual";
const amount = url.searchParams.get("amount") || "0";
const name = url.searchParams.get("name") || "";
const email = url.searchParams.get("email") || "";
const plan = getPlanBySlug(planSlug);
---

<BaseLayout
  title="Secure checkout"
  description="Mock Stripe checkout for representative view."
  noindex={true}
>
  <section class="py-12 lg:py-16" style="background: var(--color-cream); min-height: 100vh;">
    <div class="container-page">
      <div class="max-w-md mx-auto">

        {/* Mock Stripe banner */}
        <div class="mb-6 p-3 rounded-lg text-center text-xs" style="background: color-mix(in oklab, var(--color-brick) 15%, transparent); color: var(--color-brick); border: 1px dashed color-mix(in oklab, var(--color-brick) 50%, transparent);">
          ⚠️ <strong>Mock checkout</strong> · This is a representative view. Real Stripe integration pending.
        </div>

        {/* Stripe-style card */}
        <div class="rounded-xl overflow-hidden" style="background: var(--color-ivory); box-shadow: var(--shadow-deep);">
          {/* Header */}
          <div class="px-7 py-5 border-b" style="border-color: var(--color-sand);">
            <div class="flex items-center gap-2 text-sm" style="color: var(--color-slate);">
              <Icon name="lock" size="0.9em" />
              <span>Secure payment powered by</span>
              <strong style="color: #635BFF;">stripe</strong>
            </div>
          </div>

          {/* Order summary */}
          <div class="px-7 py-6 border-b" style="border-color: var(--color-sand);">
            <div class="text-xs uppercase tracking-widest mb-3" style="color: var(--color-slate);">Order summary</div>
            <div class="flex items-baseline justify-between mb-1">
              <div class="font-display text-xl" style="font-weight:500;">
                {plan ? plan.name : "Maintenance Plan"}
              </div>
              <div class="font-display text-3xl" style="font-weight:500;">
                ${amount}
              </div>
            </div>
            <div class="text-sm" style="color: var(--color-slate);">
              {billing === "annual" ? "Billed annually" : "Billed monthly"}
              {billing === "monthly" && " · Auto-renews"}
            </div>
          </div>

          {/* Customer */}
          <div class="px-7 py-5 border-b" style="border-color: var(--color-sand);">
            <div class="text-xs uppercase tracking-widest mb-2" style="color: var(--color-slate);">Customer</div>
            <div class="text-sm">
              <div>{name}</div>
              <div style="color: var(--color-slate);">{email}</div>
            </div>
          </div>

          {/* Mock card input */}
          <div class="px-7 py-6 space-y-4">
            <div>
              <label class="label">Card information</label>
              <div class="input flex items-center gap-3" style="opacity: 0.7;">
                <input type="text" placeholder="4242 4242 4242 4242" disabled class="flex-1 bg-transparent outline-none" />
                <span style="color: var(--color-slate); font-size: 0.85rem;">12/28</span>
                <span style="color: var(--color-slate); font-size: 0.85rem;">123</span>
              </div>
            </div>

            <div>
              <label class="label">Cardholder name</label>
              <input class="input" type="text" placeholder={name || "Name on card"} disabled style="opacity: 0.7;" />
            </div>

            <div class="text-xs flex items-center gap-2" style="color: var(--color-slate);">
              <Icon name="lock" size="0.85em" />
              All transactions are secure and encrypted.
            </div>
          </div>

          {/* Pay button */}
          <div class="px-7 pb-7">
            <button id="mock-pay-btn" class="btn btn-accent w-full text-base">
              <span id="mock-pay-label">Pay ${amount}</span>
              <span id="mock-pay-loading" class="hidden inline-flex items-center gap-2">
                <span class="w-4 h-4 inline-block rounded-full border-2 border-white/30 border-t-white animate-spin"></span>
                Processing payment...
              </span>
            </button>
            <a href={`/maintenance-plans/sign-up/${planSlug}/?billing=${billing}`} class="block text-center mt-3 text-xs hover:underline" style="color: var(--color-slate);">
              ← Back to enrollment
            </a>
          </div>
        </div>

        <p class="mt-6 text-center text-xs" style="color: var(--color-slate);">
          For mock purposes, click "Pay" to simulate successful payment.
        </p>
      </div>
    </div>
  </section>

  <script define:vars={{ plan: planSlug, billing, amount, name, email }}>
    (function() {
      const btn = document.getElementById('mock-pay-btn');
      const label = document.getElementById('mock-pay-label');
      const loading = document.getElementById('mock-pay-loading');

      btn.addEventListener('click', () => {
        btn.disabled = true;
        label.classList.add('hidden');
        loading.classList.remove('hidden');

        // Simulate Stripe processing delay
        setTimeout(() => {
          // Mock Stripe session ID
          const mockSessionId = 'cs_mock_' + Math.random().toString(36).substring(2, 14);
          const params = new URLSearchParams({
            session_id: mockSessionId,
            plan: plan,
            billing: billing,
            amount: amount,
            name: name,
            email: email,
          });
          window.location.href = '/maintenance-plans/thanks/?' + params.toString();
        }, 1500);
      });
    })();
  </script>
</BaseLayout>
